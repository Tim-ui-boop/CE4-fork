-MODULE_DAT EmReadModule[4] __attribute__((aligned(32)));
+/* port (patch 0235): eight enemy module slots, so a randomizer's kind can load beside the
+   room's own four without evicting one (the village raid fills all four: two villager kinds,
+   the cow, the bird -- a fifth kind killed a villager's load and the room crashed) */
+MODULE_DAT EmReadModule[8] __attribute__((aligned(32)));
 MODULE_DAT PlReadModule __attribute__((aligned(32)));
 MODULE_DAT WepReadModule __attribute__((aligned(32)));
 
