+/* Phase 2: while a dealt list is active, the ordinary Ganado count also sees the boss ids the
+ * dealer may place on counted rows. Only the exact (0x10,0x20) request used by the scripts is
+ * aliased; never change em->id, which drives AI, sound and module casts. */
+static inline bool re4CountAliasId(int id)
+{
+    return id == 0x2B || id == 0x2C || id == 0x36 || id == 0x39 || id == 0x3C;
+}
+
+static inline bool re4CountMatches(int em_id, int em_id_end, int id)
+{
+    if (id >= em_id && id <= em_id_end) {
+        return true;
+    }
+    return re4_randomizer_enemy_active() && em_id == 0x10 && em_id_end == 0x20 &&
+           re4CountAliasId(id);
+}
