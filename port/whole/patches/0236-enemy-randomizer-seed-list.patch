+/* port (patch 0236): switches on a few of the room's empty entries before EmSetFromList's loop, so a room
+   whose list the game never fills (the farm at the game's start) still hands the randomizer entries to plan
+   around; answers how many it switched on */
+extern "C" int re4_enemy_random_seed_list(void);
 extern "C" int re4_enemy_random_entry(int no, EM_LIST* out);
 extern "C" int re4_enemy_random_extra(EM_LIST* out);
