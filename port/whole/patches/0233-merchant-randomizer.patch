# Port patch, the cheat "Random merchant stock": the merchant sells items drawn from one shared pool
# (runtime/merchant_random.cpp). The merchant builds his stock by merging small tables into it, one per room and
# stage (MerchantRoomInit, MerchantGameInit, Merchant2ndRoundInit); stockDataAdd is that merge, so it is the one
# place every table passes. With the cheat on, the table is replaced by one of the same length whose ids come from
# the merchant's own price table, restricted to what may be sold at any time (weapons, ammunition, grenades,
# recovery, pesetas, treasures, weapon parts: never keys, files, maps or the case upgrades, and never the FN57 or
# 0xC5). The "new" marks keep working as in the untouched game, because the merge below sets them itself.
# With the cheat off nothing changes.
--- a/src/game/merchant.cpp
+++ b/src/game/merchant.cpp
@@ -7,6 +7,9 @@
 #include "room_data.h"
 #include "merchant.h"
 
+/* port (patch 0233): the cheat "Random merchant stock" (runtime/merchant_random.cpp) */
+extern "C" StockEntry* re4_merchant_random(StockEntry* tbl, StockEntry* out, int max);
+
 #define MERCHANT_NUM 1
 #define STOCK_MAX 64
 #define LEVEL_MAX 32
@@ -1004,6 +1007,12 @@
     StockEntry* s;
     int i;
 
+    /* port (patch 0233): the cheat "Random merchant stock" deals this table anew; the table itself is the
+       game's read-only data and is never written (static: one merge at a time, on the game thread) */
+    {
+        static StockEntry dealt[STOCK_MAX];
+        tbl = re4_merchant_random(tbl, dealt, STOCK_MAX);
+    }
     for (s = d->stock.e, i = 0; i < STOCK_MAX && s->id != 0xFFFF; i++, s++) {
         s->isNew = 0;
     }
