# Port patch (branch feature/offline-randomizer): the offline randomizer's decoded room sidecar.
# A room archive (files/StN/rNNN.das) is Yz2, an adaptive arithmetic coder (game/yz2code.cpp, yz2asm.cpp),
# so a patcher cannot rebuild one offline. Instead the decoded archive is written into the app's own folder
# randomizer/stN/rNNN.das.raw (the app's native room decoder, NativeBridge.decodeRoom) and decodeData loads
# it in place of the decoder's output (runtime/room_raw.cpp). Allocating and filling there keeps the vanilla
# path's heap bookkeeping, its out_data_size and its iTask; only the decode itself is skipped.
# The sidecar is the ORIGINAL BIG-ENDIAN decode (the bytes the fingerprints in rooms.tsv / rooms-us.tsv name).
# The port does not keep an unpacked archive in that order: runtime/yz2_decode.cpp ends the decode with
# re4_formats_unpacked, which puts the archive's table and every entry into host order, and the game's own
# GetDataExt (read.cpp, native u32 reads) expects that. So the sidecar takes the same step here; skipping it
# read the table byte-swapped and crashed in ReadAreaData (build dddaefa, room r120). A sidecar that does not
# start like a room archive, or does not read as a host-order archive afterwards, is not used: Yz2DecodeExec
# runs and the disc is played as it is, so a wrong sidecar cannot crash the game.
--- a/src/game/read.cpp
+++ b/src/game/read.cpp
@@ -116,12 +116,32 @@ static inline int BitChk16(u16& f, u16 b) { return f & b; }
 // iTask body of ReadAreaData: decompresses (Yz2) the room archive read into the top of the heap
 // into a fresh pG->pRoom allocation sized to the output (at least the room budget ROOM_ARC_SIZE
 // minus what the font already uses); HALTs when it would overlap the read buffer.
+/* port (patch 0238): the offline randomizer's decoded room sidecar (runtime/room_raw.cpp) */
+extern "C" int re4_room_raw_size(const char* name);
+extern "C" int re4_room_raw_load(const char* name, void* dst, int size);
+extern "C" int re4_room_raw_looks_like_room(const void* data);
+/* port (patch 0238): the port converts an unpacked archive to host order (runtime/yz2_decode.cpp, re4_formats_unpacked); the game's GetDataExt reads that layout */
+extern "C" void re4_formats_unpacked(void* dst, unsigned size);
+extern "C" int re4_room_raw_host_order_ok(const void* data, int size);
+extern "C" void re4_log(const char* fmt, ...); /* port: runtime/log.cpp */
+
 void decodeData()
 {
     char buf[64];
     u32 used;
+    char rawName[64];
+    int rawSize;
 
     out_data_size = Yz2DecodeSet((char*) in_data_addr, (void*) ((u32) MemGetHeapEndAddr(MemGetCurrentHeap()) - READ_BUFF_OFS));
+    /* port (patch 0238): a room the offline randomizer patched carries its decoded archive beside the .das
+       (runtime/room_raw.cpp); that archive is the room, so its size is what is allocated here instead of the
+       decoder's. The heap is the same, the iTask is the same, and a missing or unreadable sidecar falls back to
+       the decoder below. */
+    sprintf(rawName, "st%x/r%03x.das", pG->stage_no, pG->room_id);
+    rawSize = re4_room_raw_size(rawName);
+    if (rawSize > 0) {
+        out_data_size = (u32) rawSize;
+    }
 #line 59 "D:/Bio4/Prog/read.cpp"
     (pG->pRoom = MEM_ALLOC(ROOM_ARC_SIZE, 1, 0xD));
     used = (u32) pG->pRoom - (u32) pG->pStFnt;
@@ -141,7 +161,18 @@ void decodeData()
 #line 82 "D:/Bio4/Prog/read.cpp"
         HALT();
     }
-    Yz2DecodeExec(pG->pRoom);
+    /* port (patch 0238): with a sidecar, load it and run the port's own post-decode step (re4_formats_unpacked:
+       the archive's table and entries to host order, which the game's GetDataExt reads). A sidecar that does not
+       parse afterwards falls back to the game's decoder, so a wrong sidecar still cannot crash the game. */
+    if (rawSize > 0 && re4_room_raw_load(rawName, pG->pRoom, rawSize) == 1 && re4_room_raw_looks_like_room(pG->pRoom)) {
+        re4_formats_unpacked(pG->pRoom, (unsigned) rawSize);
+        if (!re4_room_raw_host_order_ok(pG->pRoom, rawSize)) {
+            re4_log("randomizer: %s: the sidecar does not parse as a room archive, decoding the disc", rawName);
+            Yz2DecodeExec(pG->pRoom);
+        }
+    } else {
+        Yz2DecodeExec(pG->pRoom);
+    }
     iTaskExit();
 }
 
