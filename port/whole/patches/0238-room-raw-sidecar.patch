# Port patch (branch feature/offline-randomizer): the offline randomizer's decoded room sidecar.
# A room archive (files/StN/rNNN.das) is Yz2, an adaptive arithmetic coder (game/yz2code.cpp, yz2asm.cpp),
# so a patcher cannot rebuild one offline. Instead the decoded archive is written into the app's own folder
# randomizer/stN/rNNN.das.raw (the app's native room decoder, NativeBridge.decodeRoom, which is checked
# against the original decoder's fingerprints) and ReadAreaData loads that sidecar in place of the room when
# it exists (runtime/room_raw.cpp). The disc file keeps its bytes and its hash, the sidecar survives a new
# import, and deleting that folder plays the disc as it is. The sidecar is read straight into pG->pRoom
# because a decoded archive is larger than the read buffer READ_BUFF_OFS. Without a sidecar nothing changes:
# the room is read and decoded as the disc has it.
--- a/src/game/read.cpp
+++ b/src/game/read.cpp
@@ -116,6 +116,10 @@ static inline int BitChk16(u16& f, u16 b) { return f & b; }
 // iTask body of ReadAreaData: decompresses (Yz2) the room archive read into the top of the heap
 // into a fresh pG->pRoom allocation sized to the output (at least the room budget ROOM_ARC_SIZE
 // minus what the font already uses); HALTs when it would overlap the read buffer.
+/* port (patch 0238): the offline randomizer's decoded room sidecar (runtime/room_raw.cpp) */
+extern "C" int re4_room_raw_size(const char* name);
+extern "C" int re4_room_raw_load(const char* name, void* dst, int size);
+
 void decodeData()
 {
     char buf[64];
@@ -156,6 +160,23 @@ void ReadAreaData()
     u32 decodeTime;
 
     sprintf(name, "st%x/r%03x.das", pG->stage_no, pG->room_id);
+    /* port (patch 0238): a decoded sidecar of this room, when the offline randomizer patched one, is read
+       straight into pG->pRoom: a decoded archive is larger than the read buffer READ_BUFF_OFS, so it must
+       not go through it. Without a sidecar the room is read and decoded as the disc has it. */
+    {
+        int rawSize = re4_room_raw_size(name);
+
+        if (rawSize > 0) {
+            pG->pRoom = MEM_ALLOC((u32) rawSize, 1, 0xD);
+            if (pG->pRoom != NULL && re4_room_raw_load(name, pG->pRoom, rawSize) == 1) {
+                pG->Rtp = GetDataExt(pG->pRoom, "RTP", 0);
+                pG->RoomMes = GetDataExt(pG->pRoom, "MDT", 0);
+                pG->pOsd = GetDataExt(pG->pRoom, "OSD", 0);
+                pG->pEmi = (EmiData*) GetDataExt(pG->pRoom, "EMI", 0);
+                return;
+            }
+        }
+    }
     if (SysFlagChk(pG, SYS_DATA_READ)) {
         SysFlagOff(pG, SYS_DATA_READ);
     } else {
