+// The companion module survives room changes: r117/r11c swap event data into it and hand the
+// pointer to the Ashley event. Only a hard/soft reset releases it (src/game/main.cpp).
+void ReleaseAshleyModule()
+{
+    if (AshleyReadModule.pData != NULL) {
+        InitModule(&AshleyReadModule);
+    }
+}
+
+// Loads the companion module into its own slot. The body is readEm()'s, without pullEmModule().
+static void* readAshleyModule(int id, void* addr, u32 size)
+{
+    u32 flags = pG->Disp_flg;
+    MODULE_DAT* m = &AshleyReadModule;
+
+    pG->Disp_flg = 0xFFFFFFFF;
+    DpfFlagOff(pG, DPF_MESSAGE);
+    if (readEmData(m, id, addr, size) == 0) {
+        pG->Disp_flg = flags;
+        return NULL;
+    }
+    setEmModule(m, id);
+    pG->Disp_flg = flags;
+    return m->pData;
+}
