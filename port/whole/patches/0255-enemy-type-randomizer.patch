# Port patch (the project owner's wish of 22.11.2026: "adapt the PC version enemy randomizer and its toggles/settings
# control for enemies as much as possible"): the enemy TYPE randomizer, runtime/enemy_types.cpp. Where patch 0231
# ("Random enemies") moves the room's Ganados to each other's places and changes their number, this changes WHAT they
# are: the model variant (type), the weapon and clothing bits (flag) and, within the Ganado family 0x10..0x20, the kind
# (id) itself - a village Ganado as Dr. Salvador with the saw, an island soldier as JJ. It works on the copy patch 0231
# made, so both switches together keep the new place AND the new kind; EmCreate takes the copy's id, since a changed
# kind needs its own module (at most 4 load at once, read.cpp:78; the deal refuses a 5th). set, room, pos, rot, hp,
# Character, Guard_r and be_flag are never written and the list itself stays as it is, so the save plays with the
# switch on or off alike. With the switch off nothing changes.
--- a/src/game/em_set.cpp
+++ b/src/game/em_set.cpp
@@ -18,6 +18,9 @@
 extern "C" int re4_enemy_random_entry(int no, EM_LIST* out);
 extern "C" int re4_enemy_random_extra(EM_LIST* out);
 extern "C" void re4_enemy_random_extra_made(int ok);
+/* port (patch 0255): the enemy TYPE randomizer (runtime/enemy_types.cpp) */
+extern "C" void re4_enemy_types_room(void);
+extern "C" int re4_enemy_types_entry(int no, EM_LIST* out);
 
 // Death bit of list entry `no` in the current enemy list (0 when no list is loaded).
 // Death bit of list entry `no` in the current list (pG->em_list_no); 0 when no list is loaded.
@@ -146,6 +149,8 @@
 
     /* port (patch 0231): the cheat "Random enemies" plans the room's start */
     re4_enemy_random_room();
+    /* port (patch 0255): the enemy TYPE randomizer plans what the room's enemies become */
+    re4_enemy_types_room();
     for (i = 0; i < 256; i++) {
         EM_LIST* d = &pG->Em_list[i];
         cEm* em;
@@ -184,7 +189,20 @@
         if (how < 0) {
             continue;
         }
-        em = EmCreate(d->id);
+        /* port (patch 0255): the enemy TYPE randomizer (another kind, model or weapon). It works on the copy
+           patch 0231 made, so a moved enemy keeps its new spot; the list itself stays as it is. */
+        if (how > 0) {
+            EM_LIST typed;
+
+            if (re4_enemy_types_entry((int) i, &typed) > 0) {
+                moved.id = typed.id;
+                moved.type = typed.type;
+                moved.flag = typed.flag;
+            }
+        } else if (re4_enemy_types_entry((int) i, &moved) > 0) {
+            how = 1;
+        }
+        em = EmCreate(how > 0 ? moved.id : d->id);
         if (em == 0) {
             pLog->err(0, 0, "EmSetFromList() Em set failed, Id = %x", d->id);
             continue;
